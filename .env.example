# Aether Social Media Platform - Environment Variables
# Copy this file to .env and update values

# Database
POSTGRES_USER=smm_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=smm_platform
DATABASE_URL=postgresql://smm_user:change_me_strong_password@localhost:5432/smm_platform?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama (Local AI)
OLLAMA_URL=http://localhost:11434

# JWT Secrets - CHANGE THESE IN PRODUCTION
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=super_secure_refresh_secret_change_me_2026

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Optional: Email / Telegram
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

TELEGRAM_BOT_TOKEN=

# Production
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
